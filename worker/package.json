{
  "name": "photo-upload-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker backend for temporary link photo upload system",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute photo-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute photo-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.109.0"
  }
}
